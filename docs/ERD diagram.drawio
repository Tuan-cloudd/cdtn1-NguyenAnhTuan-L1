        <mxCell id="SmnpNqSpiuOy5D-E4C5k-1" parent="SmnpNqSpiuOy5D-E4C5k-2" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;horizontal=1;fontSize=13;" value="INDEX dự kiến:&lt;br&gt;  idx_customer_phone &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;ON &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;customer(phone) &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt; &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;                      -&amp;gt; phục vụ US1, US5 (kiểm tra bắt trùng SĐT)&lt;br&gt;  idx_customer_status&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;ON &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;customer(status) &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt; &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;-&amp;gt; phục vụ US8 (khóa / mở khóa hồ sơ)&lt;br&gt;  idx_transaction_customer &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;ON &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;transaction(customer_id, created_at) &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;-&amp;gt; phục vụ US7 (tra cứu lịch sử giao dịch)&lt;br&gt;  idx_transaction_behavior &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;ON &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;transaction(customer_id, behavior_cat) &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;-&amp;gt; phục vụ US6 (lọc theo hành vi mua sắm)&lt;br&gt;  idx_customer_tag &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt; &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;ON &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;customer_tag(customer_id, tag_id) &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;-&amp;gt; phục vụ US4 (gắn và lọc thẻ/nhãn VIP)&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
